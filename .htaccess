Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
<FilesMatch "\.(webp|png|jpg|svg|css)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
RewriteEngine On
# Live domain only: always https://www. (leave certificate checks in /.well-known alone)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^(www\.)?webuyscrapcars-corby\.co\.uk$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^webuyscrapcars-corby\.co\.uk$ [NC]
RewriteRule ^ https://www.webuyscrapcars-corby.co.uk%{REQUEST_URI} [L,R=301]
RewriteRule ^(data/|admin\.php|job\.php) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
